{
  "name": "ai-terminal",
  "productName": "AI Terminal",
  "version": "1.0.0",
  "description": "Futuristic command center for Claude Code, Codex and local Ollama models",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "test": "node test/self-check.js",
    "dist": "electron-builder --mac --arm64",
    "install:app": "zsh scripts/build-app.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "electron": "45.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.aiterminal",
    "productName": "AI Terminal",
    "npmRebuild": false,
    "mac": { "target": "dir", "category": "public.app-category.developer-tools", "icon": "build/icon.png" },
    "asarUnpack": ["node_modules/node-pty/**"],
    "files": ["main.js", "preload.js", "models.json", "renderer/**", "services/**", "node_modules/**"]
  }
}
